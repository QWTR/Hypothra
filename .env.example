# Optional integrations only. Copy to an ignored local file; never commit real tokens.
# Supply explicitly with --env-file. Scanning and normal simulations do not read this file.
HYPOTHRA_MODEL_TOKEN=
HYPOTHRA_META_TOKEN=
HYPOTHRA_META_API_VERSION=
HYPOTHRA_TIKTOK_TOKEN=
# Optional alternative to the signed-in Codex CLI used by automatic project understanding.
HYPOTHRA_AI_ENDPOINT=
HYPOTHRA_AI_MODEL=
# Set to off to disable automatic model calls (for CI or structural-only use).
HYPOTHRA_AI_MODE=
